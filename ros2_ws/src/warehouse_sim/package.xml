<?xml version="1.0"?>
<package format="3">
  <name>warehouse_sim</name>
  <version>0.1.0</version>
  <description>AWS small warehouse in Gazebo Harmonic with N TurtleBot3 robots running Nav2.</description>
  <maintainer email="luca.gemolotto@uniud.it">Luca Gemolotto</maintainer>
  <license>MIT-0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_minimal_tb3_sim</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
